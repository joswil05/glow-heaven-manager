rules_version = '2';

// ============================================================================
// Reglas de Glow Heaven Manager
//
// La configuración anterior era `allow read, write: if true`, el modo de
// prueba que crea la consola de Firebase. Con esa regla, cualquiera que
// conozca el ID del proyecto puede leer y escribir la base entera: nombres y
// teléfonos de clientes, costos, ganancias y deudas. El ID viaja dentro de la
// aplicación, así que no es un secreto.
//
// Acá no entra cualquiera: hace falta una sesión de Google Y que ese UID esté
// autorizado. Estar autenticado NO alcanza, porque cualquier persona del mundo
// puede crearse una cuenta de Google.
//
// Hay dos formas de autorizar a alguien:
//
//   1. Agregando su UID a la lista de `autenticado()`, acá abajo, y publicando
//      las reglas con:  firebase deploy --only firestore:rules
//   2. Creando el documento `usuarios_autorizados/<UID>` desde la consola de
//      Firebase. No hace falta volver a publicar reglas; sirve para dar de
//      alta a una empleada sin tocar este archivo.
//
// El UID se saca de: Consola de Firebase > Authentication > Users.
//
// Para quitarle el acceso a alguien: borrar su UID de la lista (y publicar) o
// borrar su documento de `usuarios_autorizados`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANTE — no reintroducir `request.auth == null` acá.
    //
    // Una versión anterior de esta función empezaba con
    // `return request.auth == null || (...)`, con la intención de dejar
    // trabajar al proceso Node de Electron. En las reglas de Firestore
    // `request.auth` es null justamente cuando NADIE inició sesión, así que
    // esa condición le abría la base entera a cualquiera que llamara a la API
    // sin autenticarse: peor que no tener lista blanca.
    //
    // Si el escritorio vuelve a quedarse sin permisos, el problema está en que
    // su sesión de Firebase Auth no se restauró (ver
    // `GoogleAuthService.restaurarSesion()`), no acá.
    function autenticado() {
      return request.auth != null
          && request.auth.uid != null
          && (
            request.auth.uid in [
              'PLCUbpheiAhjelGqcZznVypc3O72',
              'ZdM86RTlEEQLYWHSBZPvsKq2YgJ3'
            ]
            || exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid))
          );
    }

    match /usuarios_autorizados/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // El dinero siempre es entero de centavos. Un decimal acá significa que
    // algo escribió fuera de la aplicación.
    //
    // En un `delete` no existe `request.resource`, así que esta función solo
    // puede usarse en create y update. Llamarla en un `write` (que incluye
    // delete) hace fallar el borrado con "Null value error", que es lo que
    // pasaba antes: deshacer la creación de un producto quedaba bloqueado.
    function centavosValidos(campo) {
      return !(campo in request.resource.data)
          || (request.resource.data[campo] is int);
    }

    match /productos/{id} {
      allow read, delete: if autenticado();
      allow create, update: if autenticado()
                   && centavosValidos('valor_inventario_usd_cents')
                   && centavosValidos('costo_unitario_usd_cents')
                   && centavosValidos('precio_venta_usd_cents');
    }

    match /ventas/{id} {
      allow read, delete: if autenticado();
      allow create, update: if autenticado()
                   && centavosValidos('total_usd_cents')
                   && centavosValidos('costo_total_usd_cents')
                   && centavosValidos('saldo_usd_cents');
    }

    match /compras/{id} {
      allow read, delete: if autenticado();
      allow create, update: if autenticado()
                   && centavosValidos('total_usd_cents')
                   && centavosValidos('envio_total_usd_cents');
    }

    match /pagos/{id} {
      allow read, delete: if autenticado();
      allow create, update: if autenticado()
                   && centavosValidos('monto_usd_cents');
    }

    match /clientes/{id} {
      allow read, write: if autenticado();
    }

    match /categorias/{id} {
      allow read, write: if autenticado();
    }

    match /parametros/{id} {
      allow read, write: if autenticado();
    }

    match /movimientos_inventario/{id} {
      // El historial de inventario explica por qué las existencias son las
      // que son. Se agrega y se lee, pero no se edita ni se borra.
      allow read, create: if autenticado();
      allow update, delete: if false;
    }

    match /eventos/{id} {
      // La auditoría se borra solo al deshacer, que es parte del flujo.
      allow read, create, delete: if autenticado();
      allow update: if false;
    }

    match /_secuencias/{id} {
      allow read, write: if autenticado();
    }

    match /resumenes_mensuales/{mes} {
      // Caché de un cálculo, no una fuente de verdad: cada documento se puede
      // rehacer leyendo las ventas de ese mes. Por eso se puede borrar sin
      // perder nada; borrarlo es justamente cómo se invalida.
      //
      // Lleva plata, así que se le exige lo mismo que al resto: centavos
      // enteros. Un decimal acá significa que algo escribió fuera de la app.
      allow read, delete: if autenticado();
      allow create, update: if autenticado()
                   && centavosValidos('ingresos_usd_cents')
                   && centavosValidos('costos_usd_cents')
                   && centavosValidos('ganancia_usd_cents');
    }

    // Cualquier colección que no esté nombrada arriba queda cerrada. Si el
    // modelo crece, la regla nueva se agrega acá a propósito.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
