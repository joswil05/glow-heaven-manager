# Normalizar saltos de línea en el repositorio
* text=auto

# Forzar LF en archivos de código
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Archivos binarios
*.png  binary
*.jpg  binary
*.ico  binary
*.db   binary
